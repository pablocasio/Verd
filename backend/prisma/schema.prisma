generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Producto {
  id             Int      @id @default(autoincrement())
  nombre         String
  descripcion    String?
  precio         Decimal  @db.Decimal(10, 2)
  stock          Int      @default(0)
  codigoBarras   String?  @unique
  categoria      String?
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt
}